{
  "name": "starweave",
  "private": true,
  "scripts": {
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "build": "turbo run build",
    "build:azure": "turbo run build --filter=web...",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "storybook": "turbo run storybook --filter=@repo/storybook",
    "build-storybook": "turbo run build-storybook --filter=@repo/storybook",
    "dev:test": "turbo run dev --filter=web",
    "dev:called-together": "turbo run dev --filter=called-together",
    "build:called-together": "turbo run build --filter=called-together...",
    "package:called-together": "npm run build:called-together && node scripts/package-called-together.mjs",
    "verify:called-together": "node scripts/verify-called-together.mjs"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.5",
    "@vercel/nft": "^1.11.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
