{
  "name": "called-together",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && npm run build:sql",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "build:sql": "tsc -p tsconfig.sql.json",
    "verify:sql": "npm run build:sql && node --conditions=react-server --env-file-if-exists=.env.local build/sql/operators/verify-sql.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@repo/ui": "*",
    "mssql": "^12.7.13",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/mssql": "^12.3.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
