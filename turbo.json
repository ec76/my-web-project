{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "test:inputs": {
      "dependsOn": ["^test:inputs"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "test": {
      "dependsOn": ["test:inputs"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["test:inputs"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "build/sql/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/apps/called-together/app/**",
        "$TURBO_ROOT$/apps/called-together/tsconfig.json"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
